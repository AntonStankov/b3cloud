#cloud-config
package_update: true
packages:
  - apt-transport-https
  - caddy
  - curl
  - debian-archive-keyring
  - debian-keyring
  - docker.io
  - git
  - python3-pip
  - python3-venv
  - unzip

runcmd:
  - mkdir -p /opt/b3cloud
  - systemctl enable --now docker
  - |
    cd /tmp
    curl -fsSLo pack.tgz https://github.com/buildpacks/pack/releases/download/v0.40.2/pack-v0.40.2-linux.tgz
    tar -xzf pack.tgz
    install -m 0755 pack /usr/local/bin/pack
  - |
    cd /tmp
    curl -fsSLo terraform.zip https://releases.hashicorp.com/terraform/1.8.2/terraform_1.8.2_linux_amd64.zip
    unzip -o terraform.zip
    install -m 0755 terraform /usr/local/bin/terraform
  - |
    cat > /opt/b3cloud/admin_api.py <<'PY'
    from fastapi import FastAPI

    app = FastAPI(title="B3Cloud Admin API", version="1.0.0")

    @app.get("/health")
    def health():
        return {"status": "ok", "api": "admin"}
    PY
  - |
    cat > /opt/b3cloud/user_api.py <<'PY'
    from fastapi import FastAPI

    app = FastAPI(title="B3Cloud User API", version="1.0.0")

    @app.get("/health")
    def health():
        return {"status": "ok", "api": "user"}
    PY
  - python3 -m venv /opt/b3cloud/.venv
  - /opt/b3cloud/.venv/bin/pip install --upgrade pip fastapi uvicorn
  - |
    cat > /etc/systemd/system/b3-admin-api.service <<'SERVICE'
    [Unit]
    Description=B3Cloud Admin API
    After=network-online.target
    Wants=network-online.target

    [Service]
    WorkingDirectory=/opt/b3cloud
    ExecStart=/opt/b3cloud/.venv/bin/uvicorn admin_api:app --host 0.0.0.0 --port 9000
    Restart=always
    RestartSec=3

    [Install]
    WantedBy=multi-user.target
    SERVICE
  - |
    cat > /etc/systemd/system/b3-user-api.service <<'SERVICE'
    [Unit]
    Description=B3Cloud User API
    After=network-online.target
    Wants=network-online.target

    [Service]
    WorkingDirectory=/opt/b3cloud
    ExecStart=/opt/b3cloud/.venv/bin/uvicorn user_api:app --host 0.0.0.0 --port 9001
    Restart=always
    RestartSec=3

    [Install]
    WantedBy=multi-user.target
    SERVICE
  - systemctl daemon-reload
  - systemctl enable --now b3-admin-api
  - systemctl enable --now b3-user-api
