# Base URL of the b3cloud user API.
# Leave empty to use same-origin requests through the Vite dev proxy.
VITE_API_BASE_URL=

# Vite dev proxy target for same-origin browser testing.
VITE_API_PROXY_TARGET=http://api.zerotrust-docker-home-server-test.download

# Tenant user API key (sent as X-Api-Key). Can also be pasted in the UI.
VITE_API_KEY=

# When "true", pricing/payments/auth/github use in-memory mocks and the deploy
# flow is simulated end-to-end without a live backend. Set "false" to hit the
# real user API for analyze/deploy/jobs.
VITE_USE_MOCKS=true
