# Base URL of the b3cloud user API. Leave empty to use same-origin (Vite proxy in dev).
VITE_API_BASE_URL=

# Tenant user API key (sent as X-Api-Key). Can also be pasted in the UI.
VITE_API_KEY=

# When "true", pricing/payments/auth/github use in-memory mocks and the deploy
# flow is simulated end-to-end without a live backend. Set "false" to hit the
# real user API for analyze/deploy/jobs.
VITE_USE_MOCKS=true
