# Base URL of the b3cloud user API.
# Leave empty in production so requests use the same origin served by Caddy.
VITE_API_BASE_URL=

# Vite dev proxy target for same-origin browser testing.
VITE_API_PROXY_TARGET=http://api.zerotrust-docker-home-server-test.download

# Supabase browser credentials. The anon key is public; never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Keep false for real API testing. True only for local UI mocking.
VITE_USE_MOCKS=false
